<!-- BR07: a dedicated disk for BACKUP / RESTORE, mounted from ./backups on the demo machine,
     separate from the live warehouse data (sheet: "Vùng sao lưu"). -->
<clickhouse>
  <storage_configuration>
    <disks>
      <backups>
        <type>local</type>
        <path>/backups/</path>
      </backups>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>backups</allowed_disk>
    <allowed_path>/backups/</allowed_path>
  </backups>
</clickhouse>
