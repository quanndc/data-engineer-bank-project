# Copy to .env and fill in. `make` and docker compose read these values.

# ---------------------------------------------------------------- Superset
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------- ClickHouse
# Local (default): leave this block commented out; the bankdw-clickhouse container is used.
#
# Cloud (e.g. Aiven): uncomment and fill in from the service's "Connection information",
# tab "ClickHouse HTTPS & JDBC". The local ClickHouse container is then not started.
# CLICKHOUSE_HOST=bankdw-xxxx.aivencloud.com
# CLICKHOUSE_PORT=12345
# CLICKHOUSE_USER=avnadmin
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_SECURE=true
# Aiven only accepts databases with the Replicated engine:
# CLICKHOUSE_DATABASE_ENGINE=Replicated
